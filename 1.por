programa
{
	
	funcao inicio()
	{
		real numero1
		real numero2
		real div,sub,mult,adi
		escreva(" numero1: ")
		leia(numero1)
			escreva(" numero2: ")
			leia(numero2)

		adi = numero1 + numero2
		div = numero1 / numero2
		sub = numero1 - numero2
		mult = numero1 * numero2	 

			escreva ("o resultado da adiçao é de: " + adi + "\n")
			escreva ("o resultado da divisão é de: " + div + "\n")
			escreva ("o resultado da subtração é de: " + sub + "\n")
			escreva ("o resultado da multiplicação é de: " + mult + "\n")






		
	}
}
