programa
{
	
	funcao inicio()
	{
		inteiro temperatura

		 escreva(" temperatura ")
		 leia(temperatura)

		 se(temperatura <= 16)
		 escreva("está fazendo frio")
		 
		se(temperatura > 16  e temperatura < 25)
		  escreva("está um clima tranquilo")
		  
		  se(temperatura > 25)
		 escreva("está hot")
	}
}
