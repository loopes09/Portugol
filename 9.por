programa
{
	
	funcao inicio()
	{
	inteiro num
	
	escreva(" digite o num ")
	leia(num)
	se (num > 0)
	{

	escreva(" o sucecessor do num", num - 1  )
	escreva(" o antecessor do num", num + 1 )
	
	}

	}
}
