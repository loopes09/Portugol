programa
{
	
	funcao inicio()
	{
		cadeia frutas [5] = {"LARANJA", "MELANCIA", "MAÇA", "BANANA", "GOIABA"}
		
		
			escreva("============= INVENTÁRIO =============\n")

			para(inteiro posicao = 4; posicao >= 0; posicao--) {
					escreva("#" + posicao)
					escreva(" " + frutas[posicao] + "\n")
					
	}
}
}

