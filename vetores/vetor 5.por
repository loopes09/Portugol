programa
{
	
	funcao inicio()
	{
		inteiro numeros[100]

		para(inteiro i = 0; i <=99; i ++){
			escreva[i] = i + 1
	}

	para(inteiro i = 0; i <=99; i ++){
			escreva(" o numero na posição #" + i " é " + numeros[i] + "\n")
}
