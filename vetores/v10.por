programa
{
	
	funcao inicio()
	{
		cadeia frutas[4] = {"Goiaba","Uva","Manga","Jabuticaba"}
		cadeia frutas2[4] = {"Jabuticaba","Manga","Uva","Goiaba"}

		
	para(inteiro posicao =0; posicao<=3; posicao ++){
		escreva(frutas[posicao] + "\n")
}
		escreva("--------------------------\n")

	para(inteiro posicao =0; posicao<=3; posicao ++){
		escreva(frutas2[posicao] + "\n")
}
}

}
