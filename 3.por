programa
{
	
	funcao inicio()
	{
		real nota
		
			escreva (" insira sua nota: ")
			leia(nota)

			se (  nota >= 7 e nota == 10 )
			escreva(" aluno está aprovado ")

			se ( nota < 7 e nota == 10 )
			escreva(" aluno está reprovado ")

			

			
	}
}
