programa
{
	
	funcao inicio()
	{
		cadeia celular
		cadeia palavra

		escreva(" digite a palavra secreta: ")
		leia(palavra)

		se(palavra == "celular")
		escreva(" você acertou a palavra secreta ")

		senao escreva(" tente novamente ")
	}
}
