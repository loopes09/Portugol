programa
{
	
	funcao inicio()
	{
		real nota1
		real nota2
		real adi

		escreva (" nota1: ")
		leia(nota1)

		escreva (" nota2: ")
		leia(nota2)

			adi = nota1 + nota2
			escreva( adi /2 )

			se (nota1 + nota2 >= 6)
			 escreva("você está aprovado :) ")

			senao escreva(" você está reprovado :( ")

	}
}
