programa
{
  funcao inicio()
  {
    real num, maior
    inteiro i = 1
    escreva("Digite o número 1: ")
    leia(maior)
    i++
    faca
    {
      escreva("Digite o número ", i, ": ")
      leia(num)
      se (num > maior)
      {
        maior = num
      }
      i++
    } enquanto (i <= 3)
    escreva("O maior número é: ", maior)
  }
}

