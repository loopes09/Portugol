programa
{
	
	funcao inicio()
	{

		inteiro numero
		inteiro n=0
		escreva("digite numero: ")
		leia(numero)
		enquanto(n < numero ){
			escreva(n + 1, "\n")
			n = 1 + n	
			
		}escreva ("67")
	}
}
